{
  "manifest_version": 3,
  "name": "Auto Applier",
  "version": "0.1.0",
  "description": "Autofills job applications from your saved profile.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Auto Applier",
    "default_popup": "popup.html"
  }
}
